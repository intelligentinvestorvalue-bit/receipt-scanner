# Copy this file to .env.local and fill in your values.

# ── App auth (required) ──────────────────────────────────────────────────────
# Password users enter on /login
APP_PASSWORD=

# Random string ≥ 32 characters used to sign session cookies
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Server-only secret for monthly sheet setup (never expose as NEXT_PUBLIC_*)
# Generate: openssl rand -base64 24
# Required for "Setup This Month's Sheet" and POST /api/setup-month
SETUP_SECRET=

# ── Google service account (Sheets + Drive only — no Vision API needed) ──────
# From the downloaded service account JSON key file
# https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key from the same JSON file
# Keep \n as literal backslash-n — do NOT expand to real newlines
GOOGLE_PRIVATE_KEY=

# Your personal Gmail — new month sheets are shared here as writer
GOOGLE_OWNER_EMAIL=

# Optional: hard-code a spreadsheet ID (skips monthly Drive name discovery)
# Spreadsheet ID from the sheet URL: /spreadsheets/d/<ID>/edit
# Share the sheet with the service account email (Editor)
# GOOGLE_SHEET_ID=

# Dedicated spreadsheet for Gmail → Pending review (optional)
# If unset, the app auto-creates "Receipt Scanner Pending" on first /pending visit
# and shares it with GOOGLE_OWNER_EMAIL. See EMAIL_PENDING_SETUP.md.
# GOOGLE_PENDING_SHEET_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Absolute site URL used only if you call internal fetch helpers
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# NOTE: GOOGLE_VISION_API_KEY is no longer used.
# OCR runs on-device with Tesseract.js.
